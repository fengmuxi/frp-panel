# master 最小配置（复制为 .env 使用；.env 已被 gitignore）
# 注意：APP_ 前缀不可省略，cleanenv 按 env-prefix 拼接读取，裸写 COOKIE_SECURE/ENABLE_REGISTER 不会生效
# 必填：>=16 位强随机串，生成 `openssl rand -hex 32`；为空或默认值 frp-panel 时 master 拒绝启动
# （历史部署仍用默认密钥时，可临时设 APP_REQUIRE_STRONG_SECRET=false 过渡，之后建议 frpp migrate rekey 轮换）
APP_GLOBAL_SECRET=""
APP_REQUIRE_STRONG_SECRET=true
MASTER_RPC_HOST=127.0.0.1
MASTER_API_HOST=127.0.0.1
# 监听 IP：默认 0.0.0.0 = 监听所有网卡（含公网）；
# 只做本机反代/本机访问时建议改 127.0.0.1，避免面板与节点 RPC 端口直接暴露公网
MASTER_RPC_LISTEN_IP=0.0.0.0
MASTER_API_LISTEN_IP=0.0.0.0
# 本地纯 HTTP 调试需要（生产走 HTTPS 反代可省）
APP_COOKIE_SECURE=false
# 注册开关：首个管理员不受此开关限制，之后想继续放开才设 true
APP_ENABLE_REGISTER=true

# DB（可选，默认 /data/data.db，本地调试建议指到工作目录）
DB_TYPE=sqlite3
DB_DSN=data.db?_pragma=journal_mode(WAL)

# 节点侧（client/server 模式才需要；由 frpp join 自动写入）
# CLIENT_ID=<面板节点ID>
# CLIENT_SECRET=<面板节点secret>
# CLIENT_RPC_URL=grpc://127.0.0.1:9001
# CLIENT_API_URL=http://127.0.0.1:9000
